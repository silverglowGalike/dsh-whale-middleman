{
  "name": "dsh-whale-middleman",
  "version": "0.3.0",
  "description": "中台（原型 whale-tail 鲸鱼尾巴）：主会话盘问 → 收敛 → 拆草稿票 → 人工批准（批准即开跑）→ 前置 done 自动接力 → turn/end 回传",
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "docs",
    "scripts",
    "test",
    "cordis.patch.yml",
    "README.md",
    "USAGE.md",
    "LICENSE",
    "icon.svg"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "orchestration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silverglowGalike/dsh-whale-middleman.git"
  },
  "license": "GPL-3.0-only",
  "scripts": {
    "test": "node scripts/test.mjs",
    "check": "node scripts/check.mjs"
  }
}